procedure pinv(int p[], int n)
local int i = 0
from i = 0 do
if p[i] < n then
local int first = p[i]
local int prev = i, int curr = first
from prev = i do
local int next = p[curr], int oldprev = prev
p[curr] -= next
p[curr] += prev
p[curr] += n
prev -= oldprev
prev += curr
curr -= prev
curr += next
delocal int next = curr, int oldprev = p[prev] - n
loop
skip
until prev = i
p[i] += n
delocal int prev = i, int curr = first
delocal int first = first
else
skip
fi p[i] >= 2 * n
i += 1
loop
skip
until i = n
delocal int i = n
local int j = 0
from j = 0 do
local int m = 0
if p[j] >= 2 * n then
m += 1
p[j] -= n
else
skip
fi m = 1
p[j] -= n
delocal int m = m
j += 1
loop
skip
until j = n
delocal int j = n


procedure main()
    int p[3]
    int n
    p[1] += 1
    p[2] += 2
    n += 3
    call pinv(p, n)
