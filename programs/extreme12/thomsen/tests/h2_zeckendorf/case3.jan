procedure zeck(int n, int z, int cnt)
local int a = 1, int b = 1, int step = 0, int d = 0
    cnt += 1
    from cnt = 1 do
        a += b
        a <=> b
    loop
        cnt += 1
    until b > n
    from step = 0 do
        z *= 10
        if a <= n then
            d += 1
        else
            skip
        fi d = 1
        z += d
        n -= a * d
        d -= z % 10
    loop
        step += 1
        a <=> b
        a -= b
    until a = 1
delocal int a = 1, int b = 2, int step = cnt - 1, int d = 0

procedure main()
    int n
    int z
    int cnt
    n += 100
    call zeck(n, z, cnt)
