procedure bgcd(int x, int y, int steps, int flags)
    from steps = 0 do
        skip
    loop
        flags *= 4
        if x % 2 = 0 then
            x /= 2
        else
            if y % 2 = 0 then
                y /= 2
                flags += 1
            else
                if x > y then
                    x -= y
                    flags += 2
                else
                    y -= x
                    flags += 3
                fi flags % 4 = 2
            fi flags % 4 = 1
        fi flags % 4 = 0
        steps += 1
    until x = y
    y -= x


procedure main()
    int x
    int y
    int steps
    int flags
    x += 1
    y += 1
    call bgcd(x, y, steps, flags)
