procedure ddec(int a[], int n)
  local int i = 1
  from i = 1 do
    skip
  loop
    local int t = a[i - 1]
    a[i] += t
    delocal int t = a[i - 1]
    i += 1
  until i = n
  delocal int i = n


procedure main()
    int a[4]
    int n
    a[0] += 3
    a[1] += 2
    a[2] += 4
    a[3] += 5
    n += 4
    call ddec(a, n)
