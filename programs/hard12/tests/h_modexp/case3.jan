procedure modexp(int base, int e, int m, int r, int q[])
   local int i = 0
   from i = 0 do
      r *= base
      q[i] += r / m
      r -= q[i] * m
      i += 1
      e -= 1
   loop
      skip
   until e = 0
   delocal int i = size(q)


procedure main()
    int base
    int e
    int m
    int r
    int q[2]
    base += 4
    e += 2
    m += 6
    r += 1
    call modexp(base, e, m, r, q)
